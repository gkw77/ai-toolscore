---
import { categories, SITE_TAGLINE, verdictFor } from "../data/tools";
import "../styles/global.css";

const verdictLabel: Record<ReturnType<typeof verdictFor>, string> = {
  use: "USE IT",
  depends: "DEPENDS",
  avoid: "AVOID",
};
const today = new Date().toISOString().slice(0, 10);
const reviewedCount = categories.reduce(
  (n, c) => n + c.subcategories.reduce((m, s) => m + s.reviews.length, 0),
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={SITE_TAGLINE} />
    <title>Tool Autopsy — AI developer tools I actually run</title>
  </head>
  <body>
    <header class="site-head">
      <nav class="cats">
        {categories.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
      </nav>
      <div class="hero">
        <p class="kicker">tool-autopsy</p>
        <h1>AI developer tools, autopsied.</h1>
        <p class="tagline">{SITE_TAGLINE}</p>
        <p class="meta">{reviewedCount} scored · last updated {today} · <a href="#method">how this works</a></p>
      </div>
    </header>

    <main>
      {categories.map((cat) => (
        <section id={cat.id} class="category">
          <div class="cat-head">
            <h2>{cat.title}</h2>
            <p class="cat-blurb">{cat.blurb}</p>
          </div>

          {cat.subcategories.map((sub) => (
            <div class="sub">
              <h3>{sub.title}</h3>
              {sub.reviews.length === 0 ? (
                <p class="empty">Not reviewed yet — I only score tools I've run on real work.</p>
              ) : (
                <ul class="reviews">
                  {sub.reviews.map((r) => {
                    const v = verdictFor(r.score);
                    return (
                      <li class="review" id={r.slug}>
                        <div class="top">
                          <div class="who">
                            <span class="name">{r.name}</span>
                            {r.repo && <a class="repo" href={r.repo}>repo ↗</a>}
                            {r.stars && <span class="stars">★ {r.stars} GH</span>}
                          </div>
                          <div class="scorebox">
                            <span class={"score score-" + v}>★ {r.score.toFixed(1)}</span>
                            <span class={"verdict verdict-" + v}>{verdictLabel[v]}</span>
                          </div>
                        </div>
                        <p class="intro">{r.intro}</p>
                        <p class="reason"><strong>Reason:</strong> {r.reason}</p>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))}
        </section>
      ))}
    </main>

    <footer id="method">
      <h2>The method</h2>
      <p>
        No tool gets a score here until it has been run on real work — not a tutorial, a demo, or
        a README. Scores are out of 10: 8+ is a tool to reach for, 6–7 depends on the situation,
        5 or below to avoid. Each card gives one line on what the tool is and one line on why it
        scored that way. External star counts, when shown, are fetched by a script — never typed by
        hand. Empty categories are honest gaps: a tool I haven't run doesn't get a card.
      </p>
      <p>
        This site is the outward half of a private rule set that audits itself — read the confession at
        <a href="https://github.com/gkw77/rule-autopsy"> rule-autopsy</a>.
      </p>
    </footer>
  </body>
</html>
